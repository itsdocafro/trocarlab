# EditorConfig: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Python: 4 spaces (ROS 2 convention)
[*.py]
indent_size = 4

# C++: 2 spaces (ROS 2 convention)
[*.{c,cc,cpp,cxx,h,hh,hpp,hxx}]
indent_size = 2

# Markdown: trailing spaces are line breaks
[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

# LICENSE: keep the official Apache 2.0 text byte for byte
[LICENSE]
trim_trailing_whitespace = unset
insert_final_newline = unset
